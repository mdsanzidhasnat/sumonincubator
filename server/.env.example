# Node environment: development | test | production
NODE_ENV=development

# HTTP server port
PORT=4000

# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017/sumonincubator

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Mongoose Studio admin panel (sidecar)
# Free tier has no authentication; keep STUDIO_ENABLED=false in production.
STUDIO_ENABLED=true
STUDIO_PATH=/admin
STUDIO_API_PATH=/admin/api
# Empty = studio's built-in localhost-only check (handles dual-stack ::ffff:127.0.0.1).
# Comma-separated IPs are allowed, e.g. STUDIO_BIND_IP=127.0.0.1,::ffff:127.0.0.1
STUDIO_BIND_IP=
