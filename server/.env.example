# Node environment: development | test | production
NODE_ENV=development

# HTTP server port
PORT=4000

# MongoDB connection string
DATABASE_URL=mongodb://localhost:27017/sumonincubator

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000

# React-Admin admin panel (served at ADMIN_PATH, authenticated via AUTH_* below)
ADMIN_ENABLED=true
ADMIN_PATH=/admin

# --- Admin auth ---
# Username for the admin login form.
ADMIN_USERNAME=admin
# bcrypt hash of the admin password. Generate with: npm run hash-password -- <password>
ADMIN_PASSWORD_HASH=$2b$10$XaaGCXZHnYQg96fEaeuWkOP2kKEts5NKXYJ9OET.NNyFLbeSvZkWm
# Secret used to sign/admin JWTs. Must be at least 32 characters.
AUTH_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Name of the httpOnly cookie that stores the JWT.
AUTH_COOKIE_NAME=si_admin
# How long the session lasts (e.g. 43200 = 12 hours, 86400 = 24 hours).
AUTH_SESSION_TTL_SECONDS=43200
